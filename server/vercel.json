{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/*.test.py",
          "**/tests/**",
          "**/docs/**",
          "**/examples/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    }
  ]
}