{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/*.test.py",
          "**/tests/**",
          "**/docs/**",
          "**/examples/**",
          "**/numpy/doc/**",
          "**/numpy/distutils/**",
          "**/scipy/doc/**",
          "**/matplotlib/mpl-data/sample_data/**",
          "**/matplotlib/mpl-data/images/**",
          "**/cv2/data/**",
          "**/reportlab/fonts/**",
          "**/reportlab/graphics/samples/**",
          "**/reportlab/graphics/barcode/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    }
  ]
}