{
  "name": "dice-analyzer",
  "version": "1.0.0",
  "description": "Information-Entropy Analysis of SEM images",
  "main": "electron/main.js",
  "scripts": {
    "frontend:build": "cd client && npm install && npm run build",
    "backend:build": "pip install pyinstaller -r server/api/requirements.txt && pyinstaller --noconfirm --onefile --name dice_backend --paths server/api --add-data \"server/api/src/core/DejaVuSans.ttf;src/core\" server/api/index.py",
    "electron:start": "NODE_ENV=development electron .",
    "dist": "npm run frontend:build && electron-builder"
  },
  "author": "DICE Team",
  "license": "ISC",
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dice.analyzer",
    "productName": "DICE Analyzer",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "client/out/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/dice_backend.exe",
        "to": "backend/dice_backend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
